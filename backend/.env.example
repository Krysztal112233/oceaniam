# Local development configuration.
# Copy this file to .env and adjust as needed.
#
# All values here override the defaults in config.toml.
# See backend/config.toml for the full set of available options.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

OCEANIAM_ADDR="0.0.0.0:8000"
OCEANIAM_CORS__ALLOW_ORIGIN="http://localhost:5173"
OCEANIAM_DATABASE__DSN="postgresql://postgres:postgres@localhost:5432/postgres"

# OCEANIAM_COOKIE__SECURE=true  # Uncomment in production to set Secure flag on auth cookies
