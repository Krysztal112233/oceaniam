# Container image tag. Set to a specific git SHA (e.g. abc1234) to
# pin the deployment, or keep "latest" to follow the main branch.
OCEANIAM_TAG=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# Backend
OCEANIAM_ADDR="0.0.0.0:8000"
OCEANIAM_DATABASE__DSN=${DATABASE_URL}
OCEANIAM_CORS__ALLOW_ORIGIN="*"

# Production must use a real 64-char hex key. Generate with: openssl rand -hex 32
OCEANIAM_MASTER_KEY=

# Independent Application Secret HMAC keyring. Generate with: openssl rand -hex 32
# Add old versions alongside the current version until all records have upgraded.
OCEANIAM_APPLICATION_SECRET_HMAC__CURRENT_VERSION=1
OCEANIAM_APPLICATION_SECRET_HMAC__KEYS__1=

# Uncomment in production to set Secure flag on auth cookies:
OCEANIAM_COOKIE__SECURE=true
