# Minimal production deployment checklist.
# The authoritative reference with all optional knobs lives in the
# repository-root .env.example.

# Container image tag. Set to a specific git SHA (e.g. abc1234) to
# pin the deployment, or keep "latest" to follow the main branch.
OCEANIAM_TAG=latest

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# Required: canonical externally visible origin. Use HTTPS in production; do not
# include a path, credentials, query, or fragment (for example https://iam.example.com).
OCEANIAM_PUBLIC_BASE_URL=
# Required: browser origin allowed by CORS (typically the same origin as above).
OCEANIAM_CORS__ALLOW_ORIGIN=
OCEANIAM_DATABASE__DSN=${DATABASE_URL}
# Required: generate with `openssl rand -hex 32`.
OCEANIAM_MASTER_KEY=

# Application Secret HMAC keyring. Generate each key with: openssl rand -hex 32
# Keep old versions alongside the current version until all records have upgraded.
OCEANIAM_APPLICATION_SECRET_HMAC__CURRENT_VERSION=1
OCEANIAM_APPLICATION_SECRET_HMAC__KEYS__1=

# Secure flag on auth cookies (required for HTTPS origins).
OCEANIAM_COOKIE__SECURE=true
