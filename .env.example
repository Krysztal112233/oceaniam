# OceanIAM configuration — the single, authoritative reference.
#
# Copy this file to `.env` for the root compose stack. When running cargo
# directly on the host (`just watch-backend`), copy it to `backend/.env`
# instead and point OCEANIAM_DATABASE__DSN at localhost.
#
# Environment variables are the ONLY configuration source. Fallback defaults
# live in backend/crates/oceaniam-common/src/config.rs; a drift test there
# keeps this file in sync with the configuration schema.

# --- PostgreSQL (container credentials, healthcheck, and DATABASE_URL derivation) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Required backend settings ---
# Defaults to 0.0.0.0:8000 when unset.
OCEANIAM_ADDR="0.0.0.0:8000"
# Canonical externally visible origin; do not include a path, credentials,
# query, or fragment. Use HTTPS outside local development.
# Local compose stack: the nginx gateway origin.
OCEANIAM_PUBLIC_BASE_URL="http://localhost:8900"
# Browser origin allowed by CORS. Use the gateway origin for the compose stack,
# or http://localhost:5173 when running the Flutter dev server directly.
OCEANIAM_CORS__ALLOW_ORIGIN="http://localhost:8900"
OCEANIAM_DATABASE__DSN=${DATABASE_URL}
# Required: generate a unique key with `openssl rand -hex 32`.
OCEANIAM_MASTER_KEY=

# Independent versioned HMAC keyring for Application Secrets.
# Generate each key with: openssl rand -hex 32
# Keep every old key version until all stored secrets have upgraded.
OCEANIAM_APPLICATION_SECRET_HMAC__CURRENT_VERSION=1
OCEANIAM_APPLICATION_SECRET_HMAC__KEYS__1=

# --- Optional database pool tuning (defaults: 200 / 128 / 4) ---
# OCEANIAM_DATABASE__SLOW_STATEMENTS_LOGGING_THRESHOLD=200
# OCEANIAM_DATABASE__MAX_CONNECTIONS=128
# OCEANIAM_DATABASE__MIN_CONNECTIONS=4

# --- Optional hardening ---
# OCEANIAM_COOKIE__SECURE=true  # Uncomment in production to set the Secure flag on auth cookies

# --- Default-disabled OIDC development/test previews ---
# Requires an HTTPS public base URL or canonical localhost/127.0.0.1/[::1] HTTP origin.
# OCEANIAM_OIDC__AUTHORIZATION_ENTRY_PREVIEW_ENABLED=false

# --- Optional telemetry ---
# JSON logs are always written to stdout. Set enabled=true to export at least one OTLP signal.
OCEANIAM_TELEMETRY__ENABLED=false
OCEANIAM_TELEMETRY__SERVICE_NAME=oceaniam
# Head-sampling ratio for traces, from 0.0 to 1.0. Defaults to 1.0.
OCEANIAM_TELEMETRY__TRACE_SAMPLE_RATIO=1.0
# OCEANIAM_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318/v1/logs
# OCEANIAM_TELEMETRY__OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Header map keys use another `__` segment, for example:
# OCEANIAM_TELEMETRY__OTLP_HEADERS__AUTHORIZATION="Bearer ..."
