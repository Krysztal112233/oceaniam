POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:${POSTGRES_PORT}/${POSTGRES_DB}

OCEANIAM_ADDR="0.0.0.0:8000"
OCEANIAM_COOKIE__SECURE=true
OCEANIAM_CORS__ALLOW_ORIGIN="*"
OCEANIAM_DATABASE__DSN=${DATABASE_URL}

# Required: generate a unique key with `openssl rand -hex 32`.
OCEANIAM_MASTER_KEY=

# Independent versioned HMAC keyring for Application Secrets.
# Generate each key with: openssl rand -hex 32
OCEANIAM_APPLICATION_SECRET_HMAC__CURRENT_VERSION=1
OCEANIAM_APPLICATION_SECRET_HMAC__KEYS__1=

OCEANIAM_TELEMETRY__ENABLED=false
OCEANIAM_TELEMETRY__SERVICE_NAME=oceaniam
# Head-sampling ratio for traces, from 0.0 to 1.0. Defaults to 1.0.
OCEANIAM_TELEMETRY__TRACE_SAMPLE_RATIO=1.0
# OCEANIAM_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318/v1/logs
# OCEANIAM_TELEMETRY__OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# Header map keys use another `__` segment, for example:
# OCEANIAM_TELEMETRY__OTLP_HEADERS__AUTHORIZATION="Bearer ..."
