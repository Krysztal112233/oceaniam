{
  "name": "@oceaniam/sdk",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./types": {
      "types": "./dist/types/index.d.mts",
      "default": "./dist/types/index.mjs"
    }
  },
  "scripts": {
    "gen:types-index": "node ./scripts/gen-types-index.mjs",
    "build": "pnpm run clean && pnpm run gen:types-index && obuild",
    "dev": "pnpm run gen:types-index && obuild --stub",
    "clean": "rm -rf dist src/types/index.ts",
    "fmt": "pnpm dlx oxfmt ."
  },
  "devDependencies": {
    "obuild": "0.4.27",
    "typescript": "~5.9.3"
  }
}
