        "monaco-editor": "^0.55.1",
        "pinia": "^3.0.4",
        "pinia-plugin-persistedstate": "^4.7.1",
        "prettier": "^3.8.1",
        "vue": "^3.5.25",
        "vue-chartjs": "^5.3.3",
        "vue-router": "^4.6.4",
        "vue-toastification": "2.0.0-rc.5"
    },
    "devDependencies": {
        "@iconify/vue": "^5.0.0",
        "@tailwindcss/vite": "^4.2.1",
        "@types/node": "^24.10.1",
        "@vitejs/plugin-vue": "^6.0.2",
        "@vue/tsconfig": "^0.8.1",
        "daisyui": "^5.5.19",
        "tailwindcss": "^4.2.1",
        "typescript": "~5.9.3",
