{
    "name": "oceaniam",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "predev": "pnpm -C packages/sdk build",
        "dev": "VITE_BASE_URL=http://127.0.0.1:8000/ vite --host",
